    <item>
      <title>人的品质才是最宝贵的</title>
      <link>https://yutao.org/philosophy/%E4%BA%BA%E7%9A%84%E5%93%81%E8%B4%A8%E6%89%8D%E6%98%AF%E6%9C%80%E5%AE%9D%E8%B4%B5%E7%9A%84/</link>
